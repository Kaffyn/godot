<?xml version="1.0" encoding="UTF-8" ?>
<class name="GestureRecognizer" inherits="RefCounted" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../doc/class.xsd">
	<brief_description>
		A robust multi-stroke gesture recognizer based on the $Q Super-Quick algorithm.
	</brief_description>
	<description>
		[GestureRecognizer] implements the $Q Super-Quick algorithm (a variation of the $P Point Cloud Recognizer). Unlike simpler recognizers, it supports **multi-stroke gestures** (e.g., drawing an 'X' with two separate lines) and is **invariant to stroke order and direction**.

		It works by converting the gesture into a normalized point cloud and matching it against a set of pre-defined or dynamically created templates using an efficient Look-up Table (LUT) approach.

		**Features:**
		- Multi-stroke support (use [method end_stroke] to separate strokes).
		- Rotation invariant (matches shapes drawn at any angle).
		- Scale and Position invariant.
		- Dynamic API: Create custom templates at runtime using [method create_template] or [method create_multistroke_template].

		**Built-in Templates:**
		- Geometric Shapes: Circle, Square, Triangle, Check, X, ZigZag.
		- Latin Alphabet: A-Z (Unistroke optimized versions).
	</description>
	<tutorials>
	</tutorials>
	<methods>
		<method name="add_point">
			<return type="void" />
			<param index="0" name="point" type="Vector2" />
			<description>
				Adds a point to the current active stroke. Call [method end_stroke] to finish the stroke and start a new one (for multi-stroke gestures).
			</description>
		</method>
		<method name="clear">
			<return type="void" />
			<description>
				Clears all current strokes, resetting the recognizer state.
			</description>
		</method>
		<method name="create_multistroke_template">
			<return type="void" />
			<param index="0" name="type" type="int" />
			<param index="1" name="strokes" type="Array" />
			<description>
				Creates a custom multi-stroke template associated with a gesture ID (can be a custom integer).
				[param strokes] must be an Array of [PackedVector2Array], where each array represents a single stroke.
			</description>
		</method>
		<method name="create_template">
			<return type="void" />
			<param index="0" name="type" type="int" />
			<param index="1" name="points" type="PackedVector2Array" />
			<description>
				Creates a custom single-stroke template associated with a gesture ID.
			</description>
		</method>
		<method name="end_stroke">
			<return type="void" />
			<description>
				Marks the end of the current stroke. Subsequent calls to [method add_point] will start a new stroke. Essential for recognizing multi-stroke characters like 'X', 'H', or 'T'.
			</description>
		</method>
		<method name="get_point_count" qualifiers="const">
			<return type="int" />
			<description>
				Returns the total number of points in all current strokes.
			</description>
		</method>
		<method name="get_points" qualifiers="const">
			<return type="PackedVector2Array" />
			<description>
				Returns a flattened array of all points in all strokes.
			</description>
		</method>
		<method name="recognize">
			<return type="Dictionary" />
			<description>
				Analyzes the accumulated strokes and returns a [Dictionary] containing:
				- [code]type[/code]: The recognized gesture ID (e.g., [constant GESTURE_CIRCLE_CLOCKWISE] or a custom ID).
				- [code]confidence[/code]: Match confidence (0.0 to 1.0).
				- [code]start_position[/code]: Start of the first stroke.
				- [code]end_position[/code]: End of the last stroke.
				- [code]duration[/code]: Total duration.
				Returns [code]GESTURE_UNKNOWN[/code] if confidence is below [member min_confidence].
			</description>
		</method>
		<method name="remove_template">
			<return type="void" />
			<param index="0" name="type" type="int" />
			<description>
				Removes all templates associated with the given gesture ID.
			</description>
		</method>
	</methods>
	<members>
		<member name="min_confidence" type="float" setter="set_min_confidence" getter="get_min_confidence" default="0.5">
			Minimum confidence threshold (0.0 to 1.0). The $Q algorithm is very permissive, so 0.5 is a reasonable default. Higher values require more precise drawing.
		</member>
		<member name="resample_points" type="int" setter="set_resample_points" getter="get_resample_points" default="32">
			Number of points to normalize the point cloud to. Lower values (e.g. 32) are faster; higher values (e.g. 64) offer slightly more precision for complex shapes.
		</member>
	</members>
